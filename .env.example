# Copie para .env e ajuste.

# MVP sem custo de API
LLM_MODE=mock

# --- OpenAI em nuvem (api.openai.com) ---
# LLM_MODE=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# --- Azure OpenAI (recurso *.openai.azure.com) ---
# A chave do portal Azure N�O funciona como OPENAI_API_KEY na API p�blica.
# LLM_MODE=openai
# OPENAI_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://SEU-RECURSO.openai.azure.com
# AZURE_OPENAI_API_KEY=  (cole a Key 1 ou Key 2 do portal, sem prefixo tipo "sua-" ou texto extra)
# Nome do deployment criado no Azure AI Studio (vis�o / multimodal, ex.: gpt-4o)
# AZURE_OPENAI_DEPLOYMENT=nome-do-deployment
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# For�ar API p�blica mesmo com vari�veis Azure no ambiente:
# OPENAI_PROVIDER=openai

# --- Finnhub (Monitor ao vivo ? not�cias e sentimento) ---
# Crie uma conta gratuita em https://finnhub.io e gere sua chave:
# FINNHUB_API_KEY=sua_chave_finnhub_aqui

# Opcional
# SECRET_KEY=uma-chave-longa-aleatoria
# PORT=5000

# --- Crypto auto-trade no boot (default ALL = todos CRYPTO_SYMBOLS) ---
# CRYPTO_AUTO_ON=ALL
# CRYPTO_AUTO_ON=BTCUSD,ETHUSD,XAUUSD,EURUSD,GBPUSD
# CRYPTO_AUTO_ON=0

# --- Contratos MT5 B3 (atualizar no rollover; WDO mensal FGHJKMNQUVXZ) ---
# WIN_MT5_SYMBOL=WINV26
# WDO_MT5_SYMBOL=WDOU26

# --- B3 V7 (GAP_FADE+ORB) ? sobe OPERANDO (default 1) ---
# V7_AUTO_ENABLED=1
# Monitor MT5 (dashboard cl�ssico WIN/WDO) sobe SEMPRE OFF ? ligar manual no painel.

# --- Monitor MT5: gate IA pre-trade (default 0 = OFF, alinhado ao BT sem IA) ---
# Com 0, fills usam so score + regras calibradas (A/B, RR, ADX/vol WDO).
# MONITOR_AI_GATE=0
# MONITOR_AI_GATE=1   # liga Azure fail-closed de novo (AGUARDAR/BLOQUEAR)

# --- Acoes B3 (runtime SCAN + fill quando AUTO_ON=1) ---
# ACOES_SYMBOLS=PETR4,VALE3,ITUB4,BBDC4,BBAS3,ABEV3,WEGE3
# ACOES_AUTO_ON=0          # 0=so SCAN | 1/ALL=permite fill GO (magics 20260810+) ? em .env use 1 para operar

